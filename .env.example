# Copy to .env for local development. Never commit .env or put credentials here.
APP_ENV=development
FLASK_SECRET_KEY=
FLASK_DEBUG=false

# Production only. Render supplies RENDER_EXTERNAL_HOSTNAME automatically.
# For a custom domain, list every accepted hostname, comma separated.
APP_ALLOWED_HOSTS=
TRUSTED_PROXY_HOPS=0
FORCE_HTTPS=false
HTTPS_VERIFIED=false
ENABLE_HSTS=false

# Paths may be overridden for a persistent production volume.
DATABASE_PATH=database.db
UPLOAD_FOLDER=static/uploads
BACKUP_DIRECTORY=backups/database

# Automated UTC backups are disabled for local development.
ENABLE_SCHEDULED_BACKUPS=false
BACKUP_HOUR_UTC=2
BACKUP_MINUTE_UTC=15
BACKUP_RETENTION_COUNT=30
BACKUP_RETENTION_DAYS=30

# URL reputation provider (Google Safe Browsing v4 Lookup API).
URL_REPUTATION_PROVIDER=google_safe_browsing
GOOGLE_SAFE_BROWSING_API_KEY=
URL_REPUTATION_TIMEOUT_SECONDS=4
URL_REPUTATION_MAX_URLS_PER_SCAN=5

# SMTP password reset. Leave blank to keep delivery unconfigured.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT_SECONDS=10

# Password-reset bounds (optional; these defaults are suitable for the MVP).
PASSWORD_RESET_TTL_SECONDS=600
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_DIGITS=8

# Tesseract is installed by the production container. Local Windows may set TESSERACT_CMD.
OCR_LANGUAGES=eng+hin
TESSERACT_CMD=

# Memory storage is suitable for the single-process local and SQLite deployment.
RATELIMIT_STORAGE_URI=memory://
